# Copy to .env (gitignored) and fill in. Real environment variables win over
# this file, so a secrets manager can inject values at run time.

# Mailbox to read. Read-only credentials are enough for everything so far.
EXODON_IMAP_HOST=imap.fastmail.com
EXODON_IMAP_USER=you@example.com

# Either the password itself...
EXODON_IMAP_PASSWORD=
# ...or the NAME of an environment variable that holds it, e.g. when a
# secrets manager injects it: `keys exec MY_IMAP_SECRET -- python3 src/...`
EXODON_IMAP_PASSWORD_ENV=
# With several accounts (EXODON_ACCOUNTS below), per-account settings win:
# EXODON_PERSONAL_IMAP_USER=you@home.example
# EXODON_PERSONAL_IMAP_PASSWORD_ENV=MY_PERSONAL_IMAP_SECRET

# Ollama for the local model backend.
EXODON_OLLAMA_URL=http://localhost:11434
EXODON_MODEL=gemma4:12b

# Shadow mode (src/shadow.py). A READ-ONLY JMAP API token per mailbox is all
# it needs, given directly or as the name of a variable that holds it.
# Under Docker, leave token VALUES out of this file (the review page loads it
# too): set only the *_ENV names here and pass the variables to the watcher
# in docker/docker-compose.override.yml.
# One mailbox:
EXODON_JMAP_TOKEN=
EXODON_JMAP_TOKEN_ENV=
# ...or several, one watcher each (names are yours to choose):
# EXODON_ACCOUNTS=work,personal
# EXODON_WORK_JMAP_TOKEN_ENV=MY_WORK_RO_JMAP
# EXODON_PERSONAL_JMAP_TOKEN_ENV=MY_PERSONAL_RO_JMAP
# Your hand-trained spam folder: the ground truth grading compares against.
# Per account with EXODON_<NAME>_TRAINING_FOLDER.
EXODON_TRAINING_FOLDER=Identified Spam
# Trust Authentication-Results only from your provider's own servers.
EXODON_AUTHSERV=messagingengine.com
# Bands: display only in shadow mode (grading uses the raw probability); in
# live mode `screen` is what gets moved to Spam.
EXODON_SCREEN_AT=0.95
EXODON_REVIEW_AT=0.5

# Live mode, per mailbox. Needs a second, WRITABLE token for that mailbox
# (EXODON_<NAME>_JMAP_WRITE_TOKEN or ..._WRITE_TOKEN_ENV), used only for moves
# and the digest; reads and push stay on the read-only one. Screened
# mail that lands in the Inbox is moved to Spam; once a day after DIGEST_AT a
# digest of the unsure ones (review band, or moved on a score below SURE_AT)
# is put in the Inbox -- created there, never sent. EXODON_DIGEST_AT=off
# turns the digest off (the readout carries the same unsure list).
# EXODON_PERSONAL_MODE=live
# EXODON_PERSONAL_JMAP_WRITE_TOKEN_ENV=MY_PERSONAL_RW_JMAP
# EXODON_DIGEST_AT=07:00
# EXODON_TZ=America/Chicago
# EXODON_SURE_AT=0.999
# Link to the review page in the digest (also its Origin check).
# EXODON_WEB_ORIGIN=https://exodon.example.net

# Where built-from-mail material lives (default: spike/, gitignored).
# EXODON_DATA_DIR=

# Review page (src/web.py): the names it answers to, and the origin its own
# buttons post from. Anything else is refused.
EXODON_WEB_HOSTS=exodon.example.net,localhost:8799,exodon-web:8799
EXODON_WEB_ORIGIN=https://exodon.example.net

# The review page's machine-readable readout (GET /api/readout, src/readout.py)
# for another agent to summarize the filtering. Off unless a token is set;
# the containers named in EXODON_WEB_READERS may call it directly.
# EXODON_READOUT_TOKEN=
# EXODON_WEB_READERS=agent
